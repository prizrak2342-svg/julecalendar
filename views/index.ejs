<!DOCTYPE html>
<html lang="nb">
<%- include('partials/head') %>
<body>
    <%- include('partials/header') %>
<main id="main-content" tabindex="-1">
    <section class="section hero" aria-labelledby="hero-title">
        <div class="container">
            <div class="hero-content">
                <h1 id="hero-title">Skap julestemning og vinn en gave i desember!</h1>
                <p>
                    Velkommen til skolens julekalender.
                    Vi teller ned til jul sammen!
                </p>
                <a class="hero-link" href="/calendar">
                    Julekalenderen
                </a>
            </div>
        </div>
    </section>

    <section class="section introduction" id="about-calendar"
             aria-labelledby="intro-title">
        <div class="container">
            <h2 id="intro-title">24 dager med julestemning</h2>
            <p>
               En ny gave for hver dag fra 1. til 24. desember.
            </p>
        </div>
    </section>

    <section class="section information" aria-labelledby="info-title">
        <div class="container">
            <h2 id="info-title">Slik fungerer kalenderen</h2>
            <p>
                Besøk kalenderen i desember og finn dagens luke.
                Bak hver luke venter noe nytt.
            </p>
        </div>
    </section>
</main>
    <%- include('partials/footer') %>
</body>
</html>
