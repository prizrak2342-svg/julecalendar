# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env. This file must contain placeholders only.

# development | production
NODE_ENV=development

# Port and interface the Express server listens on.
# In production keep HOST=127.0.0.1 and put a reverse proxy (nginx) in front.
PORT=3000
HOST=127.0.0.1

# MongoDB connection string: mongodb://<host>:<port>/<database>
# Add a username and password when MongoDB authentication is enabled:
#   mongodb://<user>:<password>@127.0.0.1:27017/julekalender?authSource=julekalender
MONGODB_URI=mongodb://127.0.0.1:27017/julekalender

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
